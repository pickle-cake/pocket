{
  "name": "pocket-tests",
  "private": true,
  "description": "Tests for Pocket. The app itself is the single file index.html.",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:core": "node --test tests/core.test.js tests/libraries.test.js tests/style.test.js tests/lint.test.js tests/landing.test.js",
    "test:browser": "node --test tests/browser.test.js tests/a11y.test.js tests/landing.browser.test.js",
    "test:webkit": "node --test tests/webkit.js",
    "lint": "eslint . && html-validate index.html landing/index.html",
    "style:baseline": "node tests/style.js --update",
    "site": "node scripts/site.js"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-html": "^8.2.1",
    "globals": "^17.13.0",
    "html-validate": "^11.17.0",
    "playwright": "^1.48.0"
  }
}
